<launch>
  <arg name="test_pythonpath" default="$(env PYTHONPATH)" />
  <include file="$(find component)/test/patient_parameters.launch" />
  <arg name="pytest_args" default="" />
  <arg name="test_name" default="test_G3T1_5" />

    <include file="$(find messages)/../configurations/target_system/test_probe.launch" />
    <include file="$(find messages)/../configurations/target_system/test_effector.launch" />
    <include file="$(find messages)/../configurations/target_system/test_g3t1_5.launch" />
  <param name="test_module" value="$(find component)/test/unit/test_G3T1_5.py"/>
  <test test-name="$(arg test_name)" pkg="ros_pytest" type="ros_pytest_runner" args="$(arg pytest_args)" time-limit="120.0" >
    <env name="PYTHONPATH" value="$(arg test_pythonpath):$(find ros_pytest)/src:$(env PYTHONPATH)" />
  </test>
</launch>
