<launch>
  <arg name="test_pythonpath" default="$(env PYTHONPATH)" />
  <arg name="pytest_args" default="" />
  <arg name="test_name" default="test_data_access" />
    <node name="data_access" pkg="repository" type="data_access" output="log" />
    <param name="frequency" value="10000" /> <!-- 10KHz, matches configurations/knowledge_repository/data_access.launch -->

    <param name="test_module" value="$(find repository)/test/unit/test_data_access.py"/>
    <test test-name="$(arg test_name)" pkg="ros_pytest" type="ros_pytest_runner" args="$(arg pytest_args)" time-limit="120.0" >
    <env name="PYTHONPATH" value="$(arg test_pythonpath):$(find ros_pytest)/src:$(env PYTHONPATH)" />
  </test>
</launch>
